FROM registry.redhat.io/ubi9/go-toolset:latest@sha256:6f246e8913d082df463b62a74c72f0d2b410583e1b2ac48add39cd7ede59ce62 as builder
ENV CGO_ENABLED=1 \
    GOEXPERIMENT=strictfipsruntime

USER root

RUN dnf install -y perl gcc openssl openssl-devel cmake gcc-c++ git curl-minimal unzip cyrus-sasl-devel rust cargo \
    $(case "$(uname -m)" in ppc64le|s390x) echo clang ;; esac)

RUN mkdir /tmp/tuftool
COPY . /tmp/tuftool

# The aws-lc-fips library has no support for s390x at this time (cpuid setup cpu_s390x.c is absent).
# We build s390x without FIPS for 1.4 releases, as this is replaced with a newer implementation in 1.5+
# Later versions of aws-lc-fips (>= 0.14.x) do bypass the OPENSSL_cpuid_setup call on s390x, but these
# also cause the ED25519 PKCS#8 parsing to panic.
RUN case "$(uname -m)" in s390x) export CFLAGS="-Wno-error=string-compare" ;; esac && \
    FIPS_FEATURE=$(case "$(uname -m)" in s390x) echo "" ;; *) echo "--features fips" ;; esac) && \
    cd /tmp/tuftool && cargo build --release $FIPS_FEATURE

FROM registry.access.redhat.com/ubi9/ubi:latest@sha256:5858f9ace07316e3b12caab62f6c2481a5030bb6bafdca5a9ea324c321ef36df as deploy

COPY --from=builder /tmp/tuftool/target/release/tuftool /usr/bin/
COPY licenses/LICENSE-APACHE /licenses/license.txt

USER 65532:65532

ENTRYPOINT ["/usr/bin/tuftool"]

LABEL description ="Tuftool is a Rust command-line utility for generating and signing TUF repositories"
LABEL io.k8s.description="Tuftool is a Rust command-line utility for generating and signing TUF repositories"
LABEL io.k8s.display-name="Tuftool container image for Red Hat Trusted Artifact Signer"
LABEL io.openshift.tags="Tuftool Trusted Artifact Signer"
LABEL summary="Provides the Tuftool binary for generating and signing TUF repositories"
LABEL com.redhat.component="tuftool"
LABEL name="rhtas/tuftool-rhel9"
